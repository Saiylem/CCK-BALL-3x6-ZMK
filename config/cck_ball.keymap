#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    Alt_Esc_to_Tab: Alt_Esc_to_Tab {
        compatible = "zmk,behavior-mod-morph";
        label = "ALT_ESC_TO_TAB";
        bindings = <&kp ESCAPE>, <&kp TAB>;

        #binding-cells = <0>;
        mods = <(MOD_LALT)>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        AltTabCombo {
            bindings = <&kp LA(TAB)>;
            key-positions = <39 0>;
            layers = <1>;
        };
    };

    macros {
        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(TAB) &kp>;
            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Primary {
            bindings = <
&Alt_Esc_to_Tab      &kp Q         &kp W         &kp E         &kp R        &kp T        &kp Y        &kp U        &kp I        &kp O     &kp P                         &kp BACKSPACE
&kp TAB              &kp A         &kp S         &kp D         &kp F        &kp G        &kp H        &kp J        &kp K        &kp L     &kp SEMI                      &kp SQT
&mt LEFT_SHIFT CAPS  &kp Z         &kp X         &kp C         &kp V        &kp B        &kp N        &kp M        &kp COMMA    &kp DOT   &kp SLASH                     &mt RIGHT_SHIFT ENTER
&kp LCTRL            &kp LEFT_WIN  &kp LEFT_ALT  &kp LEFT_ALT  &lt 2 SPACE  &lt 3 SPACE  &lt 3 SPACE  &lt 2 SPACE  &lt 1 SPACE  &kp RALT  &mt RIGHT_WIN K_CONTEXT_MENU  &mt RCTRL DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        SymNav {
            bindings = <
&kp RS(GRAVE)  &kp LS(EXCL)  &kp LS(AT)  &kp LS(POUND)  &kp LS(DLLR)   &kp LS(PRCNT)  &kp LS(CARET)  &kp LS(AMPS)   &kp LS(STAR)  &kp LS(LPAR)  &kp LS(RPAR)  &kp EQUAL
&kp TAB        &kp SPACE     &kp SPACE   &kp SPACE      &kp SPACE      &kp SPACE      &kp LBKT       &kp RBKT       &kp LS(LBRC)  &kp LS(RBRC)  &kp LS(PLUS)  &kp LS(PIPE)
&kp LSHFT      &kp SPACE     &kp SPACE   &kp SPACE      &kp SPACE      &kp SPACE      &kp SPACE      &kp SPACE      &kp SPACE     &kp SPACE     &kp UP        &kp BSLH
&kp LCTRL      &kp LGUI      &kp LALT    &kp MINUS      &kp LS(UNDER)  &kp SPACE      &kp SPACE      &kp LS(UNDER)  &kp MINUS     &kp LEFT      &kp DOWN      &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Numpad {
            bindings = <
&kp BSPC  &kp FSLH  &kp N7   &kp N8  &kp N9  &kp MINUS  &kp FSLH  &kp N7  &kp N8  &kp N9   &kp MINUS  &kp BSPC
&kp TAB   &kp STAR  &kp N4   &kp N5  &kp N6  &kp PLUS   &kp STAR  &kp N4  &kp N5  &kp N6   &kp PLUS   &kp TAB
&none     &kp N0    &kp N1   &kp N2  &kp N3  &kp RET    &kp N0    &kp N1  &kp N2  &kp N3   &kp RET    &none
&none     &none     &kp DOT  &none   &none   &none      &none     &none   &none   &kp DOT  &none      &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Functions {
            bindings = <
&kp F1     &kp F2    &kp F3    &kp F4   &kp SPACE  &kp SPACE  &trans     &trans  &kp F13  &kp F14   &kp F15   &kp F16
&kp F5     &kp F6    &kp F7    &kp F8   &trans     &kp SPACE  &kp SPACE  &trans  &kp F17  &kp F18   &kp F19   &kp F20
&kp F9     &kp F10   &kp F11   &kp F12  &trans     &trans     &trans     &trans  &kp F21  &kp F22   &kp F23   &kp F24
&kp LCTRL  &kp LGUI  &kp LALT  &trans   &trans     &trans     &trans     &trans  &trans   &kp RALT  &kp RGUI  &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Admin {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                // 编码器1：上下滚动,，,,,
                <&scroll_horizontal_encoder>;

            // 编码器2：左右滚动
        };
    };
};
