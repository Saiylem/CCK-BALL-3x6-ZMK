#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

&sl {
    bindings = <&sl>;

    /delete-property/ quick-release;
};

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    Hold_Tap_LayerPhaser: Hold_Tap_LayerPhaser {
        compatible = "zmk,behavior-hold-tap";
        label = "Hold Momentary/Tap To Layer";
        bindings = <&mo>, <&to>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        hold-while-undecided;
    };

    Interrobang: Interrobang {
        compatible = "zmk,behavior-send-string";
        label = "INTERROBANG";
        #binding-cells = <0>;
        text = "‽";
    };

    LeftTortiseShellBracket: LeftTortiseShellBracket {
        compatible = "zmk,behavior-send-string";
        label = "LEFTTORTISESHELLBRACKET";
        #binding-cells = <0>;
        text = "〔";
    };

    RightTortoiseShellBracket: RightTortoiseShellBracket {
        compatible = "zmk,behavior-send-string";
        label = "RIGHTTORTOISESHELLBRACKET";
        #binding-cells = <0>;
        text = "〕";
    };

    LeftBlackLeticularBracket: LeftBlackLeticularBracket {
        compatible = "zmk,behavior-send-string";
        label = "LEFTBLACKLETICULARBRACKET";
        #binding-cells = <0>;
        text = "【";
    };

    RightBlackLenticularBracket: RightBlackLenticularBracket {
        compatible = "zmk,behavior-send-string";
        label = "RIGHTBLACKLENTICULARBRACKET";
        #binding-cells = <0>;
        text = "】";
    };

    TDance_KP_MinusPlus: TDance_KP_MinusPlus {
        compatible = "zmk,behavior-tap-dance";
        label = "TDANCE_KP_MINUSPLUS";
        #binding-cells = <0>;
        bindings = <&kp KP_MINUS>, <&kp KP_PLUS>;

        tapping-term-ms = <200>;
    };

    TDance_KP_DivideMultiply: TDance_KP_DivideMultiply {
        compatible = "zmk,behavior-tap-dance";
        label = "TDANCE_KP_DIVIDEMULTIPLY";
        #binding-cells = <0>;
        bindings = <&kp KP_DIVIDE>, <&kp KP_MULTIPLY>;

        tapping-term-ms = <200>;
    };

    TDance_KP_DotComma: TDance_KP_DotComma {
        compatible = "zmk,behavior-tap-dance";
        label = "TDANCE_KP_DOTCOMMA";
        #binding-cells = <0>;
        tapping-term-ms = <200>;
        bindings = <&kp KP_DOT>, <&kp COMMA>;
    };

    ModMorph_KP_5N_LShift2N: ModMorph_KP_5N_LShift2N {
        compatible = "zmk,behavior-mod-morph";
        label = "MODMORPH_KP_5N_LSHIFT2N";
        bindings = <&kp KP_NUMBER_5>, <&kp KP_NUMBER_2>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT)>;
        keep-mods = <(MOD_LSFT)>;
    };

    TDance_KP_Equals_Tilde: TDance_KP_Equals_Tilde {
        compatible = "zmk,behavior-tap-dance";
        label = "TDANCE_KP_EQUALS_TILDE";
        #binding-cells = <0>;
        bindings = <&kp EQUAL>, <&kp TILDE>;

        tapping-term-ms = <200>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        LAlt_Simulation {
            bindings = <&kt LALT>;
            key-positions = <39 0>;
            timeout-ms = <5000>;
            slow-release;
            require-prior-idle-ms = <(-1)>;
            layers = <0 1 2 5>;
        };

        InterrobangCombo {
            bindings = <&Interrobang>;
            key-positions = <1 34>;
            require-prior-idle-ms = <(-1)>;
            timeout-ms = <200>;
            layers = <0 1 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Primary {
            bindings = <
&kp ESC               &kp Q         &kp W         &kp E        &kp R                      &kp T  &kp Y  &kp U  &kp I        &kp O     &kp P                         &kp BACKSPACE
&kp TAB               &kp A         &kp S         &kp D        &kp F                      &kp G  &kp H  &kp J  &kp K        &kp L     &kp SEMI                      &kp SQT
&mt LEFT_SHIFT ENTER  &kp Z         &kp X         &kp C        &kp V                      &kp B  &kp N  &kp M  &kp COMMA    &kp DOT   &kp SLASH                     &mt RIGHT_SHIFT ENTER
&mt LCTRL CAPSLOCK    &kp LEFT_WIN  &kp LEFT_ALT  &lt 1 SPACE  &Hold_Tap_LayerPhaser 2 2  &sl 3  &sl 3  &to 5  &lt 1 SPACE  &kp RALT  &mt RIGHT_WIN K_CONTEXT_MENU  &mt RCTRL DEL
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                <&scroll_vertical_encoder>;

            label = "Primary";
        };

        Symbols {
            bindings = <
&kp TAB        &kp EXCLAMATION  &kp POUND             &kp DOLLAR             &kp PERCENT       &kp CARET          &kp GRAVE  &kp ASTRK  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp MINUS      &kp UNDERSCORE
&kp AMPERSAND  &kp AT_SIGN      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp TILDE  &kp SPACE  &kp SPACE       &kp SPACE        &kp EQUAL      &kp PLUS
&kp SPACE      &kp SPACE        &kp SPACE             &kp SPACE              &kp SPACE         &kp SPACE          &kp SPACE  &kp SPACE  &kp SPACE       &kp SPACE        &kp BACKSLASH  &kp PIPE
&kp SPACE      &kp SPACE        &kp SPACE             &kp SPACE              &kp SPACE         &kp SPACE          &kp SPACE  &kp SPACE  &kp SPACE       &kp SPACE        &kp SPACE      &kp SPACE
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                <&scroll_vertical_encoder>;

            label = "Symbols";
        };

        Left_Numpad {
            bindings = <
&kp ESC              &kp F2                   &kp KP_NUMBER_7      &kp KP_NUMBER_8           &kp KP_NUMBER_9  &kp BACKSPACE              &kp SPACE  &kp SPACE  &kp SPACE    &kp SPACE  &kp SPACE  &kp SPACE
&kp TAB              &TDance_KP_Equals_Tilde  &kp KP_NUMBER_4      &ModMorph_KP_5N_LShift2N  &kp KP_NUMBER_6  &TDance_KP_MinusPlus       &kp SPACE  &kp SPACE  &kp SPACE    &kp SPACE  &kp SPACE  &kp SPACE
&mt LSHIFT KP_ENTER  &kp KP_NUMBER_0          &kp KP_NUMBER_1      &kp KP_NUMBER_2           &kp KP_NUMBER_3  &TDance_KP_DivideMultiply  &kp SPACE  &kp SPACE  &kp SPACE    &kp SPACE  &kp SPACE  &none
&mt LCTRL CAPS       &kp LEFT_ALT             &TDance_KP_DotComma  &lt 1 SPACE               &to 0            &sl 3                      &sl 3      &to 5      &lt 1 SPACE  &kp SPACE  &none      &none
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                <&scroll_vertical_encoder>;

            label = "Left Numpad";
        };

        Functions {
            bindings = <
&kp F1     &kp F2    &kp F3    &kp F4   &kp SPACE  &kp SPACE  &trans     &trans  &kp F13  &kp F14   &kp F15   &kp F16
&kp F5     &kp F6    &kp F7    &kp F8   &trans     &kp SPACE  &kp SPACE  &trans  &kp F17  &kp F18   &kp F19   &kp F20
&kp F9     &kp F10   &kp F11   &kp F12  &trans     &trans     &trans     &trans  &kp F21  &kp F22   &kp F23   &kp F24
&kp LCTRL  &kp LGUI  &kp LALT  &trans   &trans     &trans     &trans     &trans  &trans   &kp RALT  &kp RGUI  &kp RCTRL
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                <&scroll_vertical_encoder>;

            label = "FKeys/Custom Shorcuts";
        };

        Admin {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                <&scroll_vertical_encoder>;

            // 编码器2：左右滚动

            label = "Keyboard Administration";
        };

        KeyNav {
            bindings = <
&kp ESC           &kp F2        &trans        &trans       &trans                     &trans  &trans  &trans    &kp UP       &trans         &trans  &kp BACKSPACE
&kp TAB           &trans        &trans        &trans       &trans                     &trans  &trans  &kp LEFT  &kp DOWN     &kp RIGHT      &trans  &trans
&mt LSHIFT ENTER  &trans        &trans        &trans       &trans                     &trans  &trans  &trans    &trans       &trans         &trans  &mt RSHIFT ENTER
&mt LCTRL CAPS    &kp LEFT_GUI  &kp LEFT_ALT  &lt 1 SPACE  &Hold_Tap_LayerPhaser 2 2  &sl 3   &sl 3   &to 0     &lt 1 SPACE  &kp RIGHT_ALT  &trans  &mt RCTRL DEL
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                <&scroll_vertical_encoder>;

            label = "Keyboard Navigation";
        };
    };
};
