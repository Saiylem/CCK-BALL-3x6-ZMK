#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    Hold_Tap_LayerPhaser: Hold_Tap_LayerPhaser {
        compatible = "zmk,behavior-hold-tap";
        label = "Hold Momentary/Tap To Layer";
        bindings = <&mo>, <&to>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        hold-while-undecided;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        hlkh {
            bindings = <&gresc>;
            key-positions = <39 12>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Primary {
            bindings = <
&gresc                &kp Q         &kp W         &kp E        &kp R  &kp T        &kp Y  &kp U        &kp I                &kp O     &kp P                         &kp BACKSPACE
&kp TAB               &kp A         &kp S         &kp D        &kp F  &kp G        &kp H  &kp J        &kp K                &kp L     &kp SEMI                      &kp SQT
&mt LEFT_SHIFT ENTER  &kp Z         &kp X         &kp C        &kp V  &kp B        &kp N  &kp M        &kp COMMA            &kp DOT   &kp SLASH                     &mt RIGHT_SHIFT ENTER
&mt LCTRL CAPSLOCK    &kp LEFT_WIN  &kp LEFT_ALT  &lt 1 SPACE  &none  &lt 3 SPACE  &to 5  &lt 1 SPACE  &mt RIGHT_ALT SPACE  &kp RALT  &mt RIGHT_WIN K_CONTEXT_MENU  &mt RCTRL DEL
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                <&scroll_vertical_encoder>;

            label = "Primary";
        };

        SymNav {
            bindings = <
&kp GRAVE  &kp EXCLAMATION  &kp AT_SIGN  &kp POUND  &kp DOLLAR      &kp PERCENT  &kp LCTRL  &kp AMPERSAND   &kp ASTERISK    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL
&kp TILDE  &none            &kp SPACE    &mkp MB1   &mkp MB2        &mkp MB3     &kp LBKT   &kp RBKT        &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp PLUS               &kp PIPE
&kp LSHFT  &kp SPACE        &kp SPACE    &kp SPACE  &kp SPACE       &kp SPACE    &kp SPACE  &kp SPACE       &kp SPACE       &kp SPACE             &kp UP                 &kp BSLH
&kp LCTRL  &kp LGUI         &kp LALT     &kp MINUS  &kp UNDERSCORE  &kp SPACE    &kp SPACE  &kp UNDERSCORE  &kp MINUS       &kp LEFT              &kp DOWN               &kp RIGHT
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                <&scroll_vertical_encoder>;

            label = "Symbols/Keyboard Navigation";
        };

        Left_Numpad {
            bindings = <
&kp BSPC  &kp FSLH  &kp N7   &kp N8  &kp N9  &kp MINUS  &kp SPACE  &kp SPACE  &kp SPACE  &kp SPACE  &kp SPACE  &kp SPACE
&kp TAB   &kp STAR  &kp N4   &kp N5  &kp N6  &kp PLUS   &kp SPACE  &kp SPACE  &kp SPACE  &kp SPACE  &kp SPACE  &kp SPACE
&none     &kp N0    &kp N1   &kp N2  &kp N3  &kp RET    &kp SPACE  &kp SPACE  &kp SPACE  &kp SPACE  &kp SPACE  &none
&none     &none     &kp DOT  &none   &none   &none      &none      &none      &none      &kp SPACE  &none      &none
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                <&scroll_vertical_encoder>;

            label = "Left Numpad";
        };

        Functions {
            bindings = <
&kp F1     &kp F2    &kp F3    &kp F4   &kp SPACE  &kp SPACE  &trans     &trans  &kp F13  &kp F14   &kp F15   &kp F16
&kp F5     &kp F6    &kp F7    &kp F8   &trans     &kp SPACE  &kp SPACE  &trans  &kp F17  &kp F18   &kp F19   &kp F20
&kp F9     &kp F10   &kp F11   &kp F12  &trans     &trans     &trans     &trans  &kp F21  &kp F22   &kp F23   &kp F24
&kp LCTRL  &kp LGUI  &kp LALT  &trans   &trans     &trans     &trans     &trans  &trans   &kp RALT  &kp RGUI  &kp RCTRL
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                <&scroll_vertical_encoder>;

            label = "FKeys/Custom Shorcuts";
        };

        Admin {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                <&scroll_vertical_encoder>;

            // 编码器2：左右滚动

            label = "Keyboard Administration";
        };

        KeyNav {
            bindings = <
&kp ESC  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &kp LALT  &trans  &trans  &to 0   &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                <&scroll_vertical_encoder>;

            label = "Keyboard Navigation";
        };
    };
};
